{
  "name": "dsh-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Independently implemented MCP bridge for controlling durable DSH sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dsh-pilot-daemon": "./dist/bin/dsh-pilot-daemon.js",
    "dsh-pilot-mcp": "./dist/bin/dsh-pilot-mcp.js",
    "dsh-pilot-ops": "./dist/bin/dsh-pilot-ops.js"
  },
  "exports": {
    ".": "./dist/lib/daemon.js",
    "./gateway": "./dist/lib/gateway.js",
    "./adapter": "./dist/lib/adapter.js",
    "./store": "./dist/lib/store.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs test/unit test/property",
    "test:contract": "node test/run.mjs test/fake-host",
    "test:persistence": "node test/run.mjs test/persistence",
    "test:mcp": "node test/run.mjs test/mcp-e2e",
    "test:security": "node test/run.mjs test/security",
    "test:isolated-host": "node test/run.mjs test/isolated-host --isolated",
    "test:live": "node test/run.mjs test/live --live",
    "test:mutations": "node test/mutation/run.mjs",
    "test:soak": "node test/soak/run.mjs",
    "daemon": "node dist/bin/dsh-pilot-daemon.js",
    "ops": "node dist/bin/dsh-pilot-ops.js",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:contract": "tsc -p tsconfig.contract.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:contract && npm run typecheck:tests",
    "build": "tsc -p tsconfig.json",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
